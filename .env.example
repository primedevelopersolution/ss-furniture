# S.S. Furniture Environment Variables Template
# Copy this file to .env.local for local testing.
# In Vercel, set these under Project Settings -> Environment Variables.

# Notifications recipients (server-side only, never exposed to client)
OWNER_EMAIL=owner@example.com
DEVELOPER_EMAIL=dev@example.com

# SMTP configuration for Nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM_EMAIL=your-verified-sender@gmail.com
SMTP_FROM_NAME="S.S. Furniture"

# Public site URL (used for canonical URLs, Open Graph, and sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
